        "cp_modules/**/index.js",
        "chrome/cli.js",
        "chrome/web.js",
        "js/*",
        "other/*",
        "app/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "other/*",
        "js/content.js"
      ],
      "use_dynamic_url": true
