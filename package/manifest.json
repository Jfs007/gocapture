{
  "manifest_version": 3,
  "env": {
    "source": "https://dev.example.com/chrome-extension-scaffold/",
    "api": "http://localhost:3000/",
    "site": "http://localhost:3000/",
    "env": "local"
  },
  "name": "GoCapture",
  "short_name": "GoCapture",
  "author_name": "Jf.S",
  "app_module": "Offline",
  "version": "30.2.3",
  "description": "源起·伟大",
  "action": {
    "default_title": "GoCapture"
  },
  "background": {
    "service_worker": "js/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "webNavigation",
    "background",
    "management",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "cookies",
    "declarativeNetRequest",
    "downloads",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "session",
    "blocking",
    "offscreen",
    "debugger",
    "requestHeaders",
    "browsingData",
    "tabs",
    "tabGroups",
    "webRequest",
    "clipboardWrite",
    "sidePanel"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:17321 http://localhost:17321;"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "homepage_url": "https://example.com/",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "js": [
        "js/content.js"
      ],
      "css": [
        "css/index.css"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/offscreen.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "cp_modules/**/index.js",
        "chrome/cli.js",
        "chrome/web.js",
        "js/*",
        "other/*",
        "app/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "other/*",
        "js/content.js"
      ],
      "use_dynamic_url": true
    }
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ],
    "matches": [
      "*://*/*"
    ],
    "accepts_tls_channel_id": false
  }
}
