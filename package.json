{
  "name": "@sep-agent/gocapture",
  "version": "1.0.12",
  "private": true,
  "description": "GoCapture —— 本地源码定位、开发 Agent 连接服务与 Chrome 扩展。",
  "scripts": {
    "app:build": "node scripts/app-build.js",
    "app:dev": "node scripts/app-build.js --watch",
    "app:inspector:build": "node scripts/app-build.js --project vue --name gocapture --entry src/sites/gocapture/main.ts --no-minify",
    "app:inspector:dev": "node scripts/app-build.js --project vue --name gocapture --entry src/sites/gocapture/main.ts --no-minify --watch",
    "source:server": "node scripts/source-server.js",
    "release:package": "node scripts/build-npm-package.js",
    "release:gui": "node scripts/release-gui.js",
    "demo:side": "node demo/side/dev-server.js --port 5197",
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "node scripts/docs-build.js",
    "docs:build:dev": "node scripts/docs-build.js dev",
    "docs:build:prod": "node scripts/docs-build.js prod",
    "docs:preview": "vitepress preview docs",
    "brand:sync": "node scripts/product-brand.js"
  },
  "keywords": [
    "gocapture",
    "chrome-extension",
    "source-code",
    "local-agent",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vicons/utils": "^0.1.4",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "chokidar": "^3.6.0",
    "pinia": "^3.0.4",
    "sass": "^1.102.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@langchain/core": "^1.2.3",
    "@langchain/deepseek": "^1.1.5",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/mcp-adapters": "^1.1.3",
    "diff": "^8.0.4",
    "langchain": "^1.5.3",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  }
}
